# ── Environment variables for local Docker Compose ────────────────────────────
# Copy this file to .env and fill in the values.
# .env is in .gitignore — NEVER commit it.

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=pulseops
DB_USER=pulseops
DB_PASSWORD=pulseops

# JWT — must be at least 32 characters
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars

# Mail (Mailpit for local dev)
MAIL_HOST=mailpit
MAIL_PORT=1025
